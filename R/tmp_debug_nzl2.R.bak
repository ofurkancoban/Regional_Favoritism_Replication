suppressWarnings(library(sf))
sf::sf_use_s2(FALSE)

simplify_metric <- function(geom, tol_m) {
  geom_3857 <- sf::st_transform(sf::st_sfc(geom, crs = 4326), 3857)
  geom_simplified <- sf::st_simplify(geom_3857, preserveTopology = TRUE, dTolerance = tol_m)
  sf::st_geometry(sf::st_transform(geom_simplified, 4326))[[1]]
}

plad <- data.table::fread("data/raw/plad/PLAD_April_2024.tab", sep = "\t")
plad <- plad[!is.na(gid_2) & gid_2 != "." & gid_0 != "."]
cw36 <- data.table::fread("data/processed/gadm36_41_crosswalk.csv")
plad[cw36, on = .(gid_2 = gid2_36), gid_2_41 := i.gid2_41]
plad[, birth_gid2_final := data.table::fcase(!is.na(gid_2_41), gid_2_41, default = gid_2)]
ever_birth <- unique(plad[, .(gid_0, birth_gid2 = birth_gid2_final)])

l1 <- sf::st_read("data/raw/gadm_3.6/gadm36_levels.gpkg", layer = "level1", quiet = TRUE)
sf::st_geometry(l1) <- "geometry"
l2 <- sf::st_read("data/raw/gadm_3.6/gadm36_levels.gpkg", layer = "level2", quiet = TRUE)
sf::st_geometry(l2) <- "geometry"
l2_affected <- l2[l2$GID_2 %in% ever_birth$birth_gid2, ]

l1_obj <- l1[l1$GID_1 == "NZL.1_1", ]
gid1 <- "NZL.1_1"
birth_children <- ever_birth[["birth_gid2"]][ever_birth$gid_0 == "NZL"]
child_polys <- l2_affected[l2_affected$GID_2 %in% birth_children, ]
cat("child_polys matched:", nrow(child_polys), "\n")

geom1 <- sf::st_geometry(l1_obj)
holed_geom <- geom1
if (nrow(child_polys) > 0) {
  child_union <- sf::st_union(sf::st_geometry(child_polys))
  cand <- tryCatch(sf::st_difference(geom1, child_union), error = function(e) {cat("DIFF ERROR:", conditionMessage(e), "\n"); NULL})
  cat("cand null?", is.null(cand), "length:", if(!is.null(cand)) length(cand) else NA, "\n")
  if (!is.null(cand) && length(cand) == 1 && !sf::st_is_empty(cand)[1]) {
    cat("cand coord rows:", nrow(sf::st_coordinates(cand)), "\n")
    cand_clean <- tryCatch(simplify_metric(cand[[1]], 100), error = function(e) {cat("SIMPLIFY ERROR:", conditionMessage(e), "\n"); NULL})
    cat("cand_clean null?", is.null(cand_clean), "\n")
    if (!is.null(cand_clean)) cat("cand_clean coord rows:", nrow(sf::st_coordinates(sf::st_sfc(cand_clean))), "\n")
  }
}
