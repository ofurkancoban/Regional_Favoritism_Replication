              <option value='SouthAmerica'>South America</option>
            </select>
          
    
          
        </fieldset>

        <fieldset id='select-data' class='color-bg-white'>
          <legend>Data Set:</legend>
          <label for='data' class='visuallyhidden'>Data Set:</label>
          <select name='data'>
            
              <option value='disabled'>[Select data]</option>
            
              <option value='pcount' selected='selected'>Population Count Grid</option>
            
              <option value='pdens'>Population Density Grid</option>
            
              <option value='area'>Land / Geographic Unit Area Grids</option>
            
              <option value='centroids'>Centroids</option>
            
              <option value='adbnd'>Sub-national Administrative Boundaries</option>
            
              <option value='pcount_future'>Population Count Grid Future</option>
            
              <option value='pdens_future'>Population Density Grid Future</option>
            
          </select>
        </fieldset>

        <fieldset id='select-attributes' class='color-bg-white'>
          <legend>Data Attributes:</legend>
          
          <span>
            <label for='type' class="visuallyhidden">Format</label>
            <select name='type' id='type'>
            
              <option value='disabled'>[Select format]</option>
            
              <option value='bil'>.bil</option>
            
              <option value='ascii' selected='selected'>.ascii</option>
            
              <option value='wrk'>grid</option>
            
            </select>
          </span>
          
  
          
          <span>
            <label for='resolut' class="visuallyhidden">Resolution:</label>
            <select name='resolut' id='resolut'>
            
              <option value='disabled'>[Select resolution]</option>
            
              <option value='25' selected='selected'>2.5'</option>
            
            </select>
          </span>
          
  
          
          <span>
            <label for='year' class="visuallyhidden">Year:</label>
            <select name="year" id='year'>
            
              <option value='disabled'>[Select year]</option>
            
              <option value='90'>1990</option>
            
              <option value='95'>1995</option>
            
              <option value='00' selected='selected'>2000</option>
            
