          <legend>Geography:</legend>
          <label for='level-scope' class='visuallyhidden'>Level</label>
          <select name='level-scope' id='level-scope'>
            <option value='continent' selected='selected'>Region</option>
            <option value='country'>Country</option>
          </select> &raquo;
    
          
